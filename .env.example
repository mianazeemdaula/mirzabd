# .env.local
PORT=3000

# Database Connection (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/mirzabd"

# Auth.js v5 Configuration
# Generate a secret: openssl rand -base64 32 or any 32-character string
AUTH_SECRET="mirza-book-depot-secret-auth-key-32-chars-long"
AUTH_TRUST_HOST=true

# Google Auth Providers (Optional, leave blank if not using Google login)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Uploadthing Integration (File Uploads)
UPLOADTHING_TOKEN="ut_placeholder"

# Stripe Payments Configuration
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"

# Application URLs & Metadata
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Mirza Book Depot"

# First Admin Seed Setup
ADMIN_EMAIL="admin@bookdepot.com"
ADMIN_PASSWORD="StrongPass123!"
